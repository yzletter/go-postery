# ==================== 构建阶段 ====================
FROM golang:1.25.5-alpine AS builder

LABEL authors="yzletter"

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/user-service ./backend/micro/user

# ==================== 运行阶段 ====================
FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata

ENV TZ=Asia/Shanghai

WORKDIR /app

COPY --from=builder /out/user-service /app/user-service

# gRPC 端口和 Prometheus 指标端口；实际监听端口以 etcd 配置为准。
EXPOSE 9007 9107

ENTRYPOINT ["/app/user-service"]

CMD ["-env=production"]
