# ==================== 构建阶段 ====================
FROM golang:1.25.5-alpine AS builder

LABEL authors="yzletter"

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/bff-service ./backend/bff

# ==================== 运行阶段 ====================
FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata

ENV TZ=Asia/Shanghai

WORKDIR /app

COPY --from=builder /out/bff-service /app/bff-service

# BFF HTTP、WebSocket Gateway gRPC 和 Prometheus 指标端口；实际端口以 etcd 配置为准。
EXPOSE 8080 9012 9112

ENTRYPOINT ["/app/bff-service"]

CMD ["-env=production"]
