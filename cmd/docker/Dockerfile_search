# ==================== 构建阶段 ====================
FROM golang:1.25.5-alpine AS builder

LABEL authors="yzletter"

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/search-service ./backend/micro/search

# ==================== 运行阶段 ====================
FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata

ENV TZ=Asia/Shanghai

WORKDIR /app

COPY --from=builder /out/search-service /app/search-service

# gRPC 端口和 Prometheus 指标端口；实际监听端口以 etcd 配置为准。
EXPOSE 9005 9105

ENTRYPOINT ["/app/search-service"]

# 默认连接宿主机 etcd（配合 --network host）；服务器部署时可在
# docker run 末尾传入 -etcd=<IP>:2379 覆盖该地址。
CMD ["-etcd=localhost:2379"]
